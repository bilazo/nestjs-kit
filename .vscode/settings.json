{
  // ==================== Editor ====================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never" // Handle by Oxlint
  },
  "editor.rulers": [160],
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "editor.linkedEditing": true,
  "editor.colorDecorators": true,

  // ==================== Files ====================
  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.git": true,
    "**/.turbo": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },

  // ==================== Oxc (Oxlint + Oxfmt) ====================
  "oxc.enable": true,
  "oxc.lint.run": "onType",
  "eslint.enable": false, // Oxlint
  "prettier.enable": false, // Oxfmt

  // ==================== TypeScript ====================
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.suggest.autoImports": true,
  "js/ts.validate.enabled": true,

  // Important for monorepo
  "js/ts.tsserver.maxMemory": 4096,
  "js/ts.tsserver.log": "off",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": false,

  // ==================== File Associations ====================
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // ==================== Tailwindcss ====================
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.classFunctions": ["cva", "cn", "tw", "clsx", "tw\\.[a-z-]+"],

  // ==================== Search ====================
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/routeTree.gen.ts": true,
    "**/.turbo": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true
  },

  // ==================== Terminal ====================
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1"
  },
  "terminal.integrated.profiles.windows": {
    "Command Prompt": {
      "path": "cmd.exe",
      "args": ["/K", "chcp 65001"]
    },
    "PowerShell": {
      "path": "powershell.exe",
      "args": ["-NoExit", "-Command", "chcp 65001"]
    }
  },

  // ==================== Git ====================
  "git.ignoreLimitWarning": true,
  "git.autofetch": true,
  "git.autofetchPeriod": 900,

  // ==================== Misc ====================
  "workbench.colorCustomizations": {
    "editorError.foreground": "#ff0000",
    "editorWarning.foreground": "#ffaa00",
    "editorInfo.foreground": "#00aaff"
  }
}
